# systemd unit for the trainer on the VPS. Install:
#   cp trainer/crystalgenie-trainer.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now crystalgenie-trainer
#
# Tuned for the 1-core / 4 GB server that also serves the API: the API always
# wins the CPU, and a runaway run gets killed at 2 GB instead of the API.

[Unit]
Description=Crystal Genie model trainer
After=network-online.target crystalgenie.service

[Service]
Type=simple
User=crystalgenie
Group=crystalgenie
WorkingDirectory=/opt/crystalgenie/app
Environment="YOLO_CONFIG_DIR=/opt/crystalgenie/.config/Ultralytics"
Environment="HOME=/opt/crystalgenie"
Environment="OMP_NUM_THREADS=1"
Environment="TRAIN_WORKERS=0"
Environment="TRAIN_BATCH=16"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/opt/crystalgenie/app/.venv/bin/python trainer/train_worker.py
Restart=always
RestartSec=60
Nice=19
CPUWeight=10
MemoryMax=2G

[Install]
WantedBy=multi-user.target
