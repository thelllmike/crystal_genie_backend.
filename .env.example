# Copy this file to .env and fill in your values
# (Supabase dashboard -> Project Settings -> API)

SUPABASE_URL=https://ifrzpnhqjeczhrposdmw.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImlmcnpwbmhxamVjemhycG9zZG13Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzQ2MDczNzMsImV4cCI6MjA5MDE4MzM3M30.D7f2mET_XMiIt6IgttH8D-mQVP6Z8Iy3eR2SuTcrZv8

# Path to your trained YOLO11 weights
MODEL_PATH=best.pt

# Minimum confidence for a detection to be returned
CONF_THRESHOLD=0.25

# Stripe (dashboard -> Developers -> API keys). Use test keys while developing.
# The secret key stays server-side; the publishable key is also set in the app
# (lib/core/constants/stripe_config.dart).
# NEVER put a real live secret key in this file — it is committed to git.
# Real values belong only in backend/.env (gitignored) or your host's secrets.
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_KEY
STRIPE_CURRENCY=usd

# Order confirmation emails (sent from the shop's admin mailbox).
# Port 465 uses implicit SSL; use 587 with SMTP_USE_SSL=false for STARTTLS.
# The real password belongs only in backend/.env (gitignored).
SMTP_HOST=mail.crystalgenie.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=admin@crystalgenie.com
SMTP_PASSWORD=REPLACE_WITH_YOUR_MAILBOX_PASSWORD
MAIL_FROM=admin@crystalgenie.com
MAIL_FROM_NAME=Crystal Genie
# Optional: blind copy of every order confirmation, e.g. razwina@crystalgenie.com
MAIL_BCC=

# Subscription: 7-day free trial, then $3.69/month.
# STRIPE_PRICE_ID: run `python create_stripe_price.py` and paste the id it prints.
# STRIPE_WEBHOOK_SECRET: Stripe dashboard -> Developers -> Webhooks -> your
#   endpoint (POST /stripe/webhook) -> signing secret (whsec_...).
# SUPABASE_SERVICE_KEY: Supabase -> Project Settings -> API -> service_role key.
#   It bypasses RLS, so it must NEVER be shipped in the Flutter app.
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
SUPABASE_SERVICE_KEY=
SUBSCRIPTION_TRIAL_DAYS=7
SUBSCRIPTION_PRICE_LABEL=$3.69/month
